# 智慧路灯入口:Caddy 单入口 —— 托管前端静态站点(SPA)+ 反代后端 /api、/docs
#
# 默认监听 :80,局域网演示直接可用(http://<本机IP>/);
# 有域名时把下面 :80 换成你的域名(如 demo.example.com),Caddy 会自动申请
# Let's Encrypt 证书并开启 443(需 DNS 指向本机且 80/443 已放行)。

:80 {
	encode zstd gzip

	# 前端 SPA(history 路由):文件不存在时回退 index.html
	root * /srv
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /docs* {
		reverse_proxy backend:8080
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
