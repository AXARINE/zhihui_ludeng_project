# 华为云 IoTDA 北向 API 凭证(复制为 .env 后填写,勿提交)
HUAWEI_AK=访问密钥 Access Key Id
HUAWEI_SK=访问密钥 Secret Access Key
HUAWEI_PROJECT_ID=对应区域的项目 ID(我的凭证 → 项目列表)
# IoTDA 实例的应用侧接入域名(控制台 → IoTDA 实例 → 实例详情 → 接入信息),
# 形如 xxxxx.st1.iotda-app.cn-south-1.myhuaweicloud.com
HUAWEI_IOTDA_ENDPOINT=实例应用侧域名
# V11 衍生签名所需区域(标准版/企业版必用衍生签名;留空则从 endpoint 域名自动推断,如 cn-south-1)
HUAWEI_IOTDA_REGION=

# 数据库(默认本地 docker)
DATABASE_URL=postgres://streetlight:streetlight@127.0.0.1:5432/streetlight

# JWT 签名密钥(生产环境必改,建议 32 字节以上随机串)
JWT_SECRET=change-me-to-a-long-random-string
# 首次启动且账号表为空时自动创建的管理员(仅开发用;生产首次启动后请修改/删除默认账号)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
