# 华为云 IoTDA 北向 API 凭证(复制为 .env 后填写,勿提交)
HUAWEI_AK=访问密钥 Access Key Id
HUAWEI_SK=访问密钥 Secret Access Key
HUAWEI_PROJECT_ID=对应区域的项目 ID(我的凭证 → 项目列表)
# IoTDA 实例的应用侧接入域名(控制台 → IoTDA 实例 → 实例详情 → 接入信息),
# 形如 xxxxx.st1.iotda-app.cn-south-1.myhuaweicloud.com
HUAWEI_IOTDA_ENDPOINT=实例应用侧域名
# V11 衍生签名所需区域(标准版/企业版必用衍生签名;留空则从 endpoint 域名自动推断,如 cn-south-1)
HUAWEI_IOTDA_REGION=

# 数据库(默认本地 docker)
DATABASE_URL=postgres://streetlight:streetlight@127.0.0.1:5432/streetlight

# JWT 签名密钥(生产环境必改,建议 32 字节以上随机串)
JWT_SECRET=change-me-to-a-long-random-string
# 首次启动时按角色补建引导账号(某角色已有账号则跳过;仅开发用,生产首次启动后请修改/删除默认账号)
# 系统管理员 super_admin:拥有全部权限且角色权限固定不可修改
BOOTSTRAP_SUPER_ADMIN_USERNAME=superadmin
BOOTSTRAP_SUPER_ADMIN_PASSWORD=superadmin123
# 路灯管理员 admin:不含角色权限管理权限(role:manage)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# CORS 允许的前端来源,逗号分隔;留空=开发模式全放开
ALLOWED_ORIGINS=
# IoTDA 影子轮询间隔秒数(默认 8;启用数据转发推送后建议设为 60,推送为主、轮询兜底校准)
IOTDA_POLL_INTERVAL_SECS=

# ---- 性能相关(perf 压测报告结论,均有安全默认值,不设即可) ----
# 数据库连接池上限(默认 20;压测 A/B:5→20 读接口 +77~90%、控灯 +269%)
DATABASE_POOL_SIZE=20
# Argon2 校验并发闸(默认 32;每次校验 19MiB 工作内存,登录风暴下无闸会打爆 RSS)
ARGON2_MAX_CONCURRENCY=32
# 登录限流:每 IP 每分钟最大尝试次数(默认 30;0 = 不限流)
LOGIN_RATE_LIMIT_PER_MIN=30
# Argon2id 参数(默认 OWASP 推荐 19456/2/1;低配机可下调,
# 已存密码哈希不受影响——校验始终按 hash 串内嵌参数执行)
# ARGON2_M_COST_KIB=19456
# ARGON2_T=2
# ARGON2_P=1
# 压测/联调:true 时 IoTDA 北向调用本地短路(不发真实华为云请求),生产保持 false
IOTHUB_DRY_RUN=false
