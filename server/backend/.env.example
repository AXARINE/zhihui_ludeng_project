# 后端环境变量模板
# 用法：复制成 .env 并填入真实值
#   cp .env.example .env
# 【重要】.env 里有密钥，绝对不要提交到 GitHub

# ============================================
# 数据库（docker-compose 起的 Postgres，照抄即可）
# ============================================
DATABASE_URL=postgres://streetlight:streetlight@127.0.0.1:5432/streetlight

# ============================================
# 华为云 IoTDA 北向 API 凭据
# ============================================
# 注意区分两套凭据，很容易搞混：
#   南向（板子用）：device_id + 设备密钥，走 MQTT 1883，写在固件 app_config.h 里
#   北向（后端用）：AK/SK + project_id，走 HTTPS，就是下面这些
#
# AK/SK 来自 credentials.csv 的 Access Key Id / Secret Access Key
HUAWEI_AK=
HUAWEI_SK=

# 项目 ID：华为云控制台右上角"我的凭证" → "API凭证" → 华南-广州 对应的项目ID
# 需要找队友要，或者自己登控制台看
HUAWEI_PROJECT_ID=

# IoTDA 应用侧接入地址，注意是 iotda-app 不是 iotda-device
#   板子连的是 xxx.st1.iotda-device.cn-south-1.myhuaweicloud.com（设备侧）
#   后端连的是 xxx.st1.iotda-app.cn-south-1.myhuaweicloud.com   （应用侧）
# 前面那串 ID 两者相同，找队友在控制台"总览 → 接入信息"里看应用侧地址
HUAWEI_IOTDA_ENDPOINT=

# 区域，华南-广州就是 cn-south-1（不填会自动从上面域名推断）
HUAWEI_IOTDA_REGION=cn-south-1

# JWT 签名密钥（随便改一个复杂字符串，生产环境必须改）
JWT_SECRET=streetlight-jwt-secret-change-me

# 日志级别，调试时可改成 debug 看详细请求
RUST_LOG=info
